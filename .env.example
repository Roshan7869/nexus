#!/usr/bin/env python3
"""
NEXUS v4 Environment Configuration
====================================

All feature flags are OFF by default (safety first).
Enable individually as you test each subsystem.

Usage:
  cp .env.example .env
  # Edit .env to enable features
  # Then start: python -m server.unified
"""

# ── Core Settings ────────────────────────────────────────────────────────
NEXUS_PORT=8000
NEXUS_DB_PATH="$HOME/nexus/db/nexus.db"
NEXUS_CONFIG="$HOME/nexus/nexus.yaml"

# ── Feature Flags (ALL OFF by default — enable one at a time) ────────────
# Thompson Sampling model routing (50-sample minimum before activation)
NEXUS_THOMPSON_ROUTING=false

# Cluster routing (auto_trigger → cluster_router → ISO scoring)
NEXUS_CLUSTER_ROUTING=false

# Self-reflection retry loop (reflect on failures, try alternatives)
NEXUS_REFLECTION=false

# MCP sync daemon (periodic tool sync)
NEXUS_MCP_SYNC=false

# ── Provider Keys ────────────────────────────────────────────────────────
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-key-here
NVIDIA_NIM_API_KEY=your-nvidia-nim-key-here
NEXUS_API_KEY=your-nexus-auth-key-here

# ── LLM Provider URLs ───────────────────────────────────────────────────
OLLAMA_CLOUD_BASE_URL=https://cloud.ollama.com
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Safety Thresholds ───────────────────────────────────────────────────
# Minimum samples before Thompson Sampling can override defaults
NEXUS_MIN_SAMPLES=50

# Maximum reflection retries before giving up
NEXUS_MAX_REFLECTION_RETRIES=3

# ISO score threshold for tool attention gating
NEXUS_ISO_THRESHOLD=0.28

# Maximum clusters to activate per query
NEXUS_MAX_CLUSTERS=2

# ── Metrics & Observability ─────────────────────────────────────────────
NEXUS_METRICS_DIR="$HOME/.nexus/metrics"
NEXUS_LOG_LEVEL=INFO