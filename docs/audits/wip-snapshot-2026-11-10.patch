+                efc_score REAL);
+            CREATE TABLE IF NOT EXISTS tool_sessions (id INTEGER PRIMARY KEY,
+                status TEXT, outcome TEXT);
+        """)
+        ensure_routing_log_schema(conn)  # relax CHECK + add outcome_source/quality
+        conn.execute(
