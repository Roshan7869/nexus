-    scores = {}
-    for cluster, keywords in CLUSTER_TRIGGERS.items():
-        scores[cluster] = sum(1 for kw in keywords if kw.lower() in c_lower)
-    best = max(scores, key=scores.get)
-    return best if scores[best] > 0 else "general"
